---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import OtomotivInsaniCagri from '../components/OtomotivInsaniCagri.astro';
import { getCollection } from 'astro:content';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  ozet?: string;
  tarih: Date;
  seri: string;
  seriNo: number;
  seriBaslik?: string;
  url?: string;
  headings?: Heading[];
  kapakGorseli?: {
    src: string;
    alt: string;
    altyazi: string;
  };
}

const { title, ozet, tarih, seri, seriNo, seriBaslik, url, headings = [], kapakGorseli } = Astro.props;

const seriEtiketleri: Record<string, string> = {
  'otomotivde-elektrifikasyon': 'Otomotivde Elektrifikasyon',
  'beyond-the-balance-sheet': 'Bilançonun Ötesinde: Bir Şirketi Anlamak',
};

const seriMakaleleri = (await getCollection('articles'))
  .filter((a) => a.data.seri === seri && a.data.durum === 'yayında')
  .sort((a, b) => a.data.seriNo - b.data.seriNo);

const currentIndex = seriMakaleleri.findIndex((a) => a.data.seriNo === seriNo);
const prev = currentIndex > 0 ? seriMakaleleri[currentIndex - 1] : null;
const next = currentIndex >= 0 && currentIndex < seriMakaleleri.length - 1 ? seriMakaleleri[currentIndex + 1] : null;

const tarihStr = new Intl.DateTimeFormat('tr-TR', { year: 'numeric', month: 'long' }).format(tarih);

const site = Astro.site ?? new URL('https://arsandanismanlik.com.tr');
const pageUrl = new URL(Astro.url.pathname, site).href;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: ozet,
  inLanguage: 'tr',
  datePublished: tarih.toISOString(),
  dateModified: tarih.toISOString(),
  author: { '@type': 'Person', '@id': `${site.origin}/#person`, name: 'Yalçın Arsan' },
  publisher: { '@id': `${site.origin}/#organization` },
  mainEntityOfPage: pageUrl,
  articleSection: seriEtiketleri[seri] ?? seri,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  isAccessibleForFree: true,
};
---
<BaseLayout title={title} description={ozet} ogType="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleLd)} />
  <meta property="article:published_time" content={tarih.toISOString()} slot="head" />
  <meta property="article:author" content="Yalçın Arsan" slot="head" />
  {url && <meta property="article:opensource_url" content={url} slot="head" />}

  <div class="mx-auto max-w-5xl px-4 py-12">
    <header class="max-w-2xl mb-10">
      <p class="text-sm text-accent font-medium mb-2">
        {seriEtiketleri[seri] ?? seri} · {seriBaslik ?? `Bölüm ${seriNo}`}
      </p>
      <h1 class="text-3xl font-semibold text-ink mb-2">{title}</h1>
      <p class="text-sm text-warm-500">{tarihStr}</p>
    </header>

    {kapakGorseli && (
      <figure class="article-cover mb-12">
        <img
          src={kapakGorseli.src}
          width="1774"
          height="887"
          fetchpriority="high"
          decoding="async"
          alt={kapakGorseli.alt}
          class="block w-full h-auto cursor-zoom-in"
        />
        <figcaption class="mt-3 text-center text-sm text-warm-500">
          {kapakGorseli.altyazi}
        </figcaption>
      </figure>
    )}

    <div class="flex gap-12 justify-center">
      <article class="max-w-2xl min-w-0 flex-1">
      <div class="prose prose-stone max-w-none prose-headings:font-semibold prose-headings:scroll-mt-20 prose-a:text-accent prose-figcaption:text-center prose-figcaption:text-warm-500 prose-img:cursor-zoom-in">
        <slot />
      </div>
      <footer class="mt-16 pt-8 border-t border-warm-border">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-warm-500 mb-4">Serinin diğer yazıları</h2>
        <ol class="space-y-2 mb-8">
          {seriMakaleleri.map((a) => (
            a.data.seriNo === seriNo ? (
              <li class="text-sm text-ink font-medium">
                {a.data.seriNo}. {a.data.title}
                <span class="text-warm-400 font-normal"> — şu an buradasınız</span>
              </li>
            ) : (
              <li class="text-sm">
                <a href={`/makaleler/${a.slug}`} class="text-accent hover:underline">{a.data.seriNo}. {a.data.title}</a>
              </li>
            )
          ))}
        </ol>
        <nav class="flex justify-between text-sm gap-4">
          {prev ? (
            <a href={`/makaleler/${prev.slug}`} class="text-accent hover:underline">← {prev.data.seriBaslik ?? prev.data.title}</a>
          ) : <span />}
          {next ? (
            <a href={`/makaleler/${next.slug}`} class="text-accent hover:underline">{next.data.seriBaslik ?? next.data.title} →</a>
          ) : <span />}
        </nav>
        <div class="mt-10">
          <OtomotivInsaniCagri />
        </div>
        <p class="mt-8 text-xs leading-relaxed text-warm-400">
          Bu yazı Yalçın Arsan tarafından yazılmıştır. Kaynak göstererek —
          <span class="text-warm-500">Yalçın Arsan · Arsan Danışmanlık</span>, bu sayfaya bağlantı —
          özgürce alıntılayabilir, paylaşabilir ve üzerine kurabilirsiniz.
          <a href="https://creativecommons.org/licenses/by/4.0/" rel="license" class="underline hover:text-accent">CC BY 4.0</a>
        </p>
      </footer>
      </article>
      <TableOfContents headings={headings} />
    </div>
  </div>

  <div id="lightbox" aria-hidden="true">
    <img id="lightbox-img" src="" alt="" />
  </div>
  <style>
    #lightbox {
      position: fixed;
      inset: 0;
      z-index: 50;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      background: rgba(20, 16, 12, 0.9);
      cursor: zoom-out;
    }
    #lightbox.open { display: flex; }
    #lightbox img {
      max-width: 95vw;
      max-height: 92vh;
      width: auto;
      height: auto;
      background: #fff;
      padding: 1rem;
      box-sizing: border-box;
      border-radius: 6px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    }
  </style>
  <style is:global>
    .prose a[data-footnote-ref] {
      font-weight: 700;
      text-decoration: none;
      padding: 0 1px;
      scroll-margin-top: 5rem;
    }
    .prose a[data-footnote-ref]::before {
      content: '[';
    }
    .prose a[data-footnote-ref]::after {
      content: ']';
    }
  </style>
  <script>
    const box = document.getElementById('lightbox');
    const boxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    if (box && boxImg) {
      document.querySelectorAll<HTMLImageElement>('.prose img, .article-cover img').forEach((img) => {
        img.addEventListener('click', () => {
          boxImg.src = img.currentSrc || img.src;
          boxImg.alt = img.alt;
          box.classList.add('open');
          box.setAttribute('aria-hidden', 'false');
        });
      });
      const close = () => {
        box.classList.remove('open');
        box.setAttribute('aria-hidden', 'true');
      };
      box.addEventListener('click', close);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
      });
    }
  </script>

  <style is:global>
    .xref-popover {
      position: fixed;
      z-index: 60;
      display: none;
      max-width: 380px;
      padding: 0.7rem 0.85rem;
      background: #fffdf9;
      color: #2c2620;
      border: 1px solid #e7ddcf;
      border-top: 3px solid #b5623c;
      border-radius: 8px;
      box-shadow: 0 10px 34px rgba(44, 38, 32, 0.18);
      font-size: 0.85rem;
      line-height: 1.55;
    }
    .xref-popover.open { display: block; animation: xrefPopIn 0.13s ease-out; }
    @keyframes xrefPopIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: none; }
    }
    .xref-popover-title {
      font-weight: 700;
      font-size: 0.78rem;
      color: #b5623c;
      margin-bottom: 0.3rem;
    }
    .xref-popover-body { color: #3d362e; }
    .xref-popover-hint {
      margin-top: 0.5rem;
      padding-top: 0.4rem;
      border-top: 1px solid #efe7d9;
      font-size: 0.72rem;
      color: #8a7f6e;
    }
    .xref-popover-loading { color: #8a7f6e; font-style: italic; }
    @media (prefers-reduced-motion: reduce) {
      .xref-popover.open { animation: none; }
    }
  </style>
  <script>
    (() => {
      const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      if (!canHover) return;

      const links = Array.from(
        document.querySelectorAll<HTMLAnchorElement>('.prose a[href*="/makaleler/"]')
      ).filter((a) => (a.getAttribute('href') || '').includes('#'));
      if (!links.length) return;

      const docCache = new Map<string, Promise<Document | null>>();
      const previewCache = new Map<string, { title: string; body: string } | null>();

      const pop = document.createElement('div');
      pop.className = 'xref-popover';
      pop.setAttribute('role', 'tooltip');
      document.body.appendChild(pop);

      let showTimer: number | undefined;
      let hideTimer: number | undefined;
      let current: HTMLAnchorElement | null = null;

      function fetchDoc(pathname: string) {
        if (!docCache.has(pathname)) {
          docCache.set(
            pathname,
            fetch(pathname)
              .then((r) => (r.ok ? r.text() : Promise.reject(new Error('fetch'))))
              .then((html) => new DOMParser().parseFromString(html, 'text/html'))
              .catch(() => null)
          );
        }
        return docCache.get(pathname) as Promise<Document | null>;
      }

      function extractPreview(doc: Document | null, fragId: string) {
        if (!doc) return null;
        const el = doc.getElementById(fragId);
        if (!el) return null;
        let title = '';
        let body = '';
        if (/^H[1-6]$/.test(el.tagName)) {
          title = (el.textContent || '').trim();
          const parts: string[] = [];
          let node: Element | null = el.nextElementSibling;
          while (node && !/^H[1-6]$/.test(node.tagName) && parts.join(' ').length < 300) {
            if (['P', 'UL', 'OL'].includes(node.tagName)) {
              const t = (node.textContent || '').trim();
              if (t) parts.push(t);
            } else if (node.tagName === 'FIGURE') {
              const cap = node.querySelector('figcaption');
              if (cap && cap.textContent) parts.push(cap.textContent.trim());
            }
            node = node.nextElementSibling;
          }
          body = parts.join(' ');
        } else {
          const block = el.closest('p, li');
          const own = (el.textContent || '').trim();
          if (block && (block.textContent || '').trim().length > own.length) {
            body = (block.textContent || '').trim();
          } else {
            let node: Element | null = (block || el).nextElementSibling;
            while (node && !['P', 'LI'].includes(node.tagName)) node = node.nextElementSibling;
            body = node ? (node.textContent || '').trim() : block ? (block.textContent || '').trim() : own;
          }
        }
        body = body.replace(/\s+/g, ' ').trim();
        if (body.length > 330) body = body.slice(0, 327).replace(/\s+\S*$/, '') + '…';
        if (!body) return null;
        return { title, body };
      }

      function place(link: HTMLAnchorElement) {
        const r = link.getBoundingClientRect();
        const pw = pop.offsetWidth;
        const ph = pop.offsetHeight;
        const m = 8;
        const headerH = 80;
        const left = Math.max(m, Math.min(r.left, window.innerWidth - pw - m));
        let top: number;
        if (r.bottom + ph + m < window.innerHeight) top = r.bottom + m;
        else if (r.top - ph - m > headerH) top = r.top - ph - m;
        else top = Math.max(headerH + m, window.innerHeight - ph - m);
        pop.style.left = left + 'px';
        pop.style.top = top + 'px';
      }

      function render(preview: { title: string; body: string }) {
        pop.replaceChildren();
        if (preview.title) {
          const t = document.createElement('div');
          t.className = 'xref-popover-title';
          t.textContent = preview.title;
          pop.appendChild(t);
        }
        const b = document.createElement('div');
        b.className = 'xref-popover-body';
        b.textContent = preview.body;
        pop.appendChild(b);
        const h = document.createElement('div');
        h.className = 'xref-popover-hint';
        h.textContent = 'Tıkla → yeni sekmede aç';
        pop.appendChild(h);
      }

      async function show(link: HTMLAnchorElement) {
        current = link;
        const href = link.getAttribute('href') || '';
        const hashIdx = href.indexOf('#');
        const pathname = href.slice(0, hashIdx);
        const frag = decodeURIComponent(href.slice(hashIdx + 1));
        const loading = document.createElement('div');
        loading.className = 'xref-popover-loading';
        loading.textContent = 'Yükleniyor…';
        pop.replaceChildren(loading);
        pop.classList.add('open');
        place(link);
        let preview = previewCache.get(href);
        if (preview === undefined) {
          const doc = await fetchDoc(pathname);
          preview = extractPreview(doc, frag);
          previewCache.set(href, preview);
        }
        if (current !== link) return;
        if (!preview) {
          hide();
          return;
        }
        render(preview);
        place(link);
      }

      function hide() {
        pop.classList.remove('open');
        current = null;
      }

      links.forEach((link) => {
        link.addEventListener('mouseenter', () => {
          clearTimeout(hideTimer);
          showTimer = window.setTimeout(() => show(link), 200);
        });
        link.addEventListener('mouseleave', () => {
          clearTimeout(showTimer);
          hideTimer = window.setTimeout(hide, 160);
        });
        link.addEventListener('focus', () => {
          clearTimeout(hideTimer);
          show(link);
        });
        link.addEventListener('blur', () => {
          clearTimeout(showTimer);
          hide();
        });
      });

      pop.addEventListener('mouseenter', () => clearTimeout(hideTimer));
      pop.addEventListener('mouseleave', () => {
        hideTimer = window.setTimeout(hide, 160);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') hide();
      });
      window.addEventListener('scroll', () => { if (current) hide(); }, { passive: true });
    })();
  </script>
</BaseLayout>
