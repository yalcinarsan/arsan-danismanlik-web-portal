---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import OtomotivInsaniCagri from '../../components/OtomotivInsaniCagri.astro';
import { getCollection } from 'astro:content';

const allArticles = (await getCollection('articles', (e) => e.data.durum === 'yayında')).sort(
  (a, b) => a.data.seriNo - b.data.seriNo
);

const seriler = [
  { key: 'otomotivde-elektrifikasyon', label: 'Otomotivde Elektrifikasyon: 100 Yılda Bir Gelen Değişimin Anatomisi' },
  { key: 'beyond-the-balance-sheet', label: 'Bilançonun Ötesinde: Bir Şirketi Anlamak' },
];
---
<BaseLayout title="Makaleler" description="Otomotiv elektrifikasyonu ve finansal analiz üzerine yazı dizileri.">
  <section class="mx-auto max-w-5xl px-4 py-16">
    <h1 class="text-3xl font-semibold text-ink mb-8">Makaleler</h1>

    {allArticles.length === 0 && (
      <p class="text-warm-500">Henüz yayınlanmış makale yok.</p>
    )}

    {seriler.map((seri) => {
      const items = allArticles.filter((a) => a.data.seri === seri.key);
      if (items.length === 0) return null;
      const [seriAna, seriAlt] = seri.label.split(/:\s(.+)/);
      return (
        <div class="mb-12">
          <h2 class="text-lg font-semibold text-ink mb-4">
            {seriAna}{seriAlt && <>: <span class="text-accent">{seriAlt}</span></>}
          </h2>

          {/* Bütünleşik metin — dizinin tamamı tek sayfada. Kart grid'in
              ÜSTÜNDE ve tam genişlikte duruyor ki altı bölümün toplamı
              olduğu görsel olarak da anlaşılsın. */}
          {seri.key === 'otomotivde-elektrifikasyon' && (
            <a
              href="/makaleler/otomotivde-elektrifikasyon/"
              class="group block mb-6 rounded-lg border-2 border-accent/40 bg-sand p-6 hover:border-accent transition-colors"
            >
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div class="min-w-0">
                  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent mb-2">
                    Bütünleşik metin
                  </p>
                  <p class="font-serif text-xl font-semibold text-ink group-hover:text-accent transition-colors">
                    Altı bölümün tamamı, tek sayfada
                  </p>
                  <p class="text-sm text-warm-600 mt-2 max-w-2xl leading-relaxed">
                    Diziyi baştan sona okumak isteyenler için bütün metin bir arada.
                  </p>
                </div>
                <span class="shrink-0 text-sm text-accent underline underline-offset-4">
                  Tamamını oku
                </span>
              </div>
            </a>
          )}

          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {items.map((a) => (
              <ArticleCard
                slug={a.slug}
                title={a.data.title}
                ozet={a.data.ozet}
                seriBaslik={a.data.seriBaslik}
                seriNo={a.data.seriNo}
                tarih={a.data.tarih}
              />
            ))}
          </div>
        </div>
      );
    })}

    {allArticles.length > 0 && (
      <div class="mt-4">
        <OtomotivInsaniCagri />
      </div>
    )}
  </section>
</BaseLayout>
