---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_EPOSTA } from '../lib/site';

const sorular = [
  'Satışı kim yapacak: Üretici, distribütör, acente veya bayi?',
  'Sipariş ve fiziksel araç birbiriyle nasıl eşleşecek?',
  'Araç siparişi hangi aşamada, sıradaki adım ne?',
  'Hangi taraf, hangi bilgiyi görecek, hangi işlemi yapabilecek?',
  'Tescil, ödeme, sevkiyat ve teslimat gibi görevler nasıl izlenecek?',
];

const sabitVeYapilandirilan = [
  {
    sabit: 'Kurumlar, kullanıcılar ve yetkiler',
    yapilandirilan: 'Doğrudan satış, acente, Bayi ve distribütör rolleri',
  },
  {
    sabit: 'Ürün, sipariş ve tekil araç/VIN ilişkisi',
    yapilandirilan: 'Satıcı kimliği, sorumluluklar ve bilgi görünürlüğü',
  },
  {
    sabit: 'Durumlar, görevler, işlem zamanı ve işlemi yapan kullanıcı',
    yapilandirilan: 'Ürün ağacı, tedarik kaynağı ve operasyon aşamaları',
  },
  {
    sabit: 'Ortak kayıt ve denetim izi',
    yapilandirilan: 'Belgeler, bildirimler ve gerekli dış sistem bağlantıları',
  },
];

const akıs = [
  'Ürün ve kanal kurulumu',
  'Sipariş',
  'Üretim kuyruğu veya mevcut araç havuzu',
  'Araç / VIN',
  'Tahsis',
  'Tescil ve teslimat',
  'Sahiplik dönemi',
];

const kurulumAdimlari = [
  {
    baslik: 'İşletim modeli',
    metin: 'Kanal, roller, sorumluluklar, tedarik ve teslimat akışı ile kabul ölçütleri netleştirilir.',
  },
  {
    baslik: 'Platform kurulumu',
    metin: 'Kurumlar, kullanıcılar, yetkiler, ürün ağacı ve başlangıç verisi hazırlanır.',
  },
  {
    baslik: 'Akış ve bağlantılar',
    metin: 'Gerekli durumlar, görevler, belgeler ve ilk kapsamın zorunlu bağlantıları kurulur.',
  },
  {
    baslik: 'Kullanıcı testi ve açılış',
    metin: 'Taraflarla kabul testi yapılır, kullanıcılar hazırlanır ve sistem kontrollü biçimde devreye alınır.',
  },
];

const calisanKapsam = [
  'Üretici ürün ve adet planını yayımlar.',
  'Bayi planı görür ve siparişini iletir.',
  'Sipariş kadar tekil araç kaydı oluşur; VIN bilgileri araç bazında tutulur.',
  'Üretici üretim görünürlüğünü ve sevkiyatı yönetir.',
  'Bayi sevk edilen araçları teslim aldığını kendi hesabından kaydeder.',
  'İşlem zamanı, işlemi yapan kullanıcı ve durum değişiklikleri denetim izinde korunur.',
];

const hedefKurumlar = [
  'Türkiye’de henüz satış ve dağıtım yapılanmasını kurmamış otomotiv markaları',
  'Yeni üreticiler ve elektrikli mobilite girişimleri',
  'Türkiye pazarına yeni giren marka ve distribütörler',
  'Mevcut kanal ve teslimat modelini yenilemek isteyen otomotiv şirketleri',
];

const description = 'Türkiye’de otomotiv sipariş, stok ve satış yapılanmasını kuran markalar için konfigüre edilebilir OSSS platformu.';
const akisDemoAdresi = import.meta.env.DEV
  ? 'http://127.0.0.1:3000/demo-akis/'
  : 'https://platform.arsandanismanlik.com.tr/demo-akis/';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Otomotiv Sipariş, Stok, Satış (OSSS) Sistemi',
  description,
  provider: { '@id': 'https://arsandanismanlik.com.tr/#organization' },
  areaServed: { '@type': 'Country', name: 'Türkiye' },
  serviceType: 'Otomotiv satış ve dağıtım işletim sistemi kurulumu',
  url: 'https://arsandanismanlik.com.tr/otomotiv-satis-dagitim-sistemi/',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'İlk operasyonel kapsam ne kadar sürede kurulur?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Hazır çekirdek üzerinde marka için öncelikli ilk operasyonel kapsam 3–4 haftada kurulabilir. Takvim, karar yetkilisinin, gerekli verilerin ve sistem erişimlerinin sağlanmasıyla başlar; ileri seviye entegrasyonlar ile hukuki veya mali onay bekleyen kalemler ayrıca planlanır.',
      },
    },
    {
      '@type': 'Question',
      name: 'Sistem yalnızca doğrudan satış modeli için mi tasarlandı?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Hayır. Platform doğrudan satış, acente, Bayi ve distribütör ilişkilerini taşıyacak biçimde yapılandırılabilir.',
      },
    },
    {
      '@type': 'Question',
      name: 'Platform bugün çalışıyor mu?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Evet. Çalışan referans uygulamada Üretici ve Bayi aynı kalıcı veri üzerinde ayrı kullanıcı hesapları ve farklı yetkilerle çalışır; ürün planından siparişe, tekil araç/VIN kaydından sevkiyat ve Bayi teslim alımına uzanan çekirdek akış çalışır.',
      },
    },
  ],
};
---

<BaseLayout
  title="Otomotiv Sipariş, Stok, Satış (OSSS) Sistemi"
  description={description}
  image="/images/services/otomotiv-satis-dagitim-sistemi.webp"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <section class="border-b border-warm-border bg-sand">
    <div class="mx-auto max-w-5xl px-4 py-14 sm:py-20">
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.16em] text-accent">Otomotiv işletim sistemi</p>
      <h1 class="max-w-4xl text-4xl font-semibold leading-tight text-ink sm:text-5xl">
        Otomotiv Sipariş, Stok, Satış (OSSS) Sistemi
      </h1>
      <p class="mt-7 max-w-4xl text-2xl font-medium leading-snug text-ink sm:text-3xl">
        Türkiye’de kurulu satış ve satış sonrası ağı olmayan markalar için paket çözüm.
      </p>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-warm-700">
        Üretimi bitmiş aracı müşteriyle buluşturmak için gereken tüm süreçleri tek bir akışta topladık!
      </p>
      <p class="mt-7 max-w-3xl text-base leading-relaxed text-warm-700 sm:text-lg">
        Türkiye’de satış ve dağıtım yapılanmasını yeni kuran ya da yeniden yapılandırmak isteyen otomotiv markaları
        için konfigüre edilebilir bir platform sunuyoruz. Kanal yapısından ürün ve sipariş yönetimine, araç/VIN
        takibinden tahsis ve teslimata kadar <strong>üretimden satışa kadar olan süreçleri</strong> esnek bir akışta
        topluyoruz.
      </p>
      <p class="mt-7 max-w-3xl text-base font-medium leading-relaxed text-ink sm:text-lg">
        Eğer Türkiye’de araç (otomobil, motosiklet, mikro otomobil) satmakla ilgili bir sistem ve altyapı arıyorsanız bize ulaşın.
      </p>
      <div class="mt-5 flex flex-col gap-3 sm:flex-row">
        <a
          href={`mailto:${SITE_EPOSTA}?subject=Otomotiv%20satış%20ve%20dağıtım%20sistemi`}
          class="inline-flex min-h-11 items-center justify-center rounded-md bg-accent px-5 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          Bize ulaşın
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 sm:py-14">
    <figure class="overflow-hidden rounded-2xl border border-warm-border bg-white shadow-sm">
      <figcaption class="border-b border-warm-border px-5 py-5 sm:flex sm:items-end sm:justify-between sm:gap-8">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">Sistem akışı</p>
          <h2 class="mt-2 text-xl font-semibold text-ink sm:text-2xl">Operasyonun her adımı sistemde görünür</h2>
          <p class="mt-2 max-w-3xl text-sm leading-relaxed text-warm-600 sm:text-base">
            Ürün tanımından bayi teslimine kadar sipariş, üretim, VIN ve sevkiyat adımları aynı operasyon üzerinde ilerler.
          </p>
        </div>
        <a
          href={akisDemoAdresi}
          target="_blank"
          rel="noreferrer"
          class="mt-4 inline-block shrink-0 text-sm font-semibold text-accent hover:underline sm:mt-0"
        >
          Akışı tam ekranda inceleyin →
        </a>
      </figcaption>
      <div class="relative aspect-[4/3] overflow-hidden bg-[#f5eedf] sm:aspect-[1672/944]">
        <iframe
          src={`${akisDemoAdresi}?embed=hero`}
          title="Siparişten teslimata otomotiv sistem akışı"
          class="absolute inset-0 h-full w-full border-0"
          loading="eager"
        ></iframe>
      </div>
    </figure>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-14 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14">
      <div>
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-accent">Dağıtım hazırlığı</p>
        <h2 class="text-3xl font-semibold leading-tight text-ink">Aracınız hazır olabilir. Peki onu müşteriye ulaştıracak akış hazır mı?</h2>
        <p class="mt-6 text-lg leading-relaxed text-warm-700">
          Türkiye’ye giren bir otomotiv markasının yalnızca satış sitesine ihtiyacı yoktur. Şu soruların birlikte
          cevaplanması gerekir:
        </p>
      </div>
      <ul class="grid gap-3 sm:grid-cols-2" aria-label="Kurulum sırasında cevaplanan temel sorular">
        {sorular.map((soru, i) => (
          <li class:list={['rounded-xl border border-warm-border bg-white p-5 text-sm leading-relaxed text-warm-700', i === sorular.length - 1 && 'sm:col-span-2']}>
            <span class="mb-3 block text-xs font-semibold text-accent">0{i + 1}</span>
            {soru}
          </li>
        ))}
      </ul>
    </div>
    <div class="mt-10 max-w-4xl space-y-5 text-lg leading-relaxed text-warm-700">
      <p>
        Bu cevaplar ayrı belge ve sistemlerde tutulduğunda sipariş, araç, bayi ve müşteri arasındaki bağ zayıflar,
        akış ve sorumluluklar belirsizleşir, stok, teknik kontrol aşamaları ve teslimat gibi kritik adımların
        görünürlüğünü takip etmek zorlaşır.
      </p>
      <p>
        Bizim platformumuz <strong>sistemin aynı operasyon akışı üzerinde çalışmasını</strong> sağlar. OSSS
        (Otomotiv Sipariş, Stok ve Satış) sistemi, <strong>üretici ve distribütörler için bir yazılım çözümüdür</strong>.
      </p>
    </div>
  </section>

  <section class="bg-sand">
    <div class="mx-auto max-w-5xl px-4 py-14 sm:py-20">
      <h2 class="text-3xl font-semibold text-ink">İşletim modeli ve yazılım birlikte tasarlanır</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        <article class="rounded-xl border border-warm-border bg-paper p-6">
          <p class="text-sm font-semibold text-accent">01</p>
          <h3 class="mt-3 text-xl font-semibold text-ink">İşletim modeli</h3>
          <p class="mt-3 leading-relaxed text-warm-600">
            Satış kanalı yapısı, aktörleri, sorumlulukları, karar noktaları ve sistemin ilk canlı kapsamı netleştirilir.
          </p>
        </article>
        <article class="rounded-xl border border-warm-border bg-paper p-6">
          <p class="text-sm font-semibold text-accent">02</p>
          <h3 class="mt-3 text-xl font-semibold text-ink">Çekirdek yapı</h3>
          <p class="mt-3 leading-relaxed text-warm-600">
            Kurumlar, kullanıcılar, ürün ağacı, sipariş ve araç/VIN kayıtları, yetkiler ve denetim akışı kurulur.
          </p>
        </article>
        <article class="rounded-xl border border-warm-border bg-paper p-6">
          <p class="text-sm font-semibold text-accent">03</p>
          <h3 class="mt-3 text-xl font-semibold text-ink">İlk kapsam &amp; devreye alma</h3>
          <p class="mt-3 leading-relaxed text-warm-600">
            Seçilen akışlar, gerekli rapor ve belgeler ile ilk kapsam için gerekli bağlantılar tamamlanır; iki taraflı kullanıcı testiyle kontrollü açılışa geçilir.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-14 sm:py-20">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-semibold text-ink">Her markada sabit kalan, markaya göre yapılandırılan unsurlar</h2>
      <p class="mt-5 text-lg leading-relaxed text-warm-700">
        Her markanın ihtiyacı farklıdır: Kimi üreticiden doğrudan müşteriye satmayı, kimi akışı bir distribütör ya
        da satış ağı üzerinden yürütmeyi tercih eder.
      </p>
    </div>
    <div class="mt-9 overflow-hidden rounded-xl border border-warm-border">
      <div class="hidden grid-cols-2 bg-ink text-sm font-semibold text-paper sm:grid">
        <div class="p-4">Sabit ürün çekirdeği</div>
        <div class="border-l border-white/15 p-4">Üreticiyle yapılandırılan alanlar</div>
      </div>
      <div class="divide-y divide-warm-border bg-white">
        {sabitVeYapilandirilan.map((satir) => (
          <div class="grid sm:grid-cols-2">
            <div class="p-4 text-sm leading-relaxed text-warm-700">
              <span class="mb-1 block text-xs font-semibold text-accent sm:hidden">Sabit ürün çekirdeği</span>
              {satir.sabit}
            </div>
            <div class="border-t border-warm-border p-4 text-sm leading-relaxed text-warm-700 sm:border-l sm:border-t-0">
              <span class="mb-1 block text-xs font-semibold text-accent sm:hidden">Üreticiyle yapılandırılan alanlar</span>
              {satir.yapilandirilan}
            </div>
          </div>
        ))}
      </div>
    </div>
    <aside class="mt-8 rounded-xl border-l-4 border-accent bg-sand p-6 sm:p-8">
      <h3 class="text-xl font-semibold text-ink">Markaya özgü, otomotive uygun altyapı</h3>
      <p class="mt-3 max-w-4xl leading-relaxed text-warm-700">
        Bu hizmetin amacı, o markanın ihtiyacına özgü olan, ama otomotivin temel dinamiklerini de dikkate alan
        çekirdek yapıyı <strong>markanın gerçek işletim modeli</strong> haline getirmektir.
      </p>
    </aside>
  </section>

  <section class="border-y border-warm-border bg-white">
    <div class="mx-auto grid max-w-5xl gap-10 px-4 py-14 sm:py-20 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="text-3xl font-semibold text-ink">OSSS tek bir kanal modeli dayatmaz</h2>
        <p class="mt-5 text-lg leading-relaxed text-warm-700">
          Platformumuz <strong>doğrudan satış, acente, Bayi ve distribütör ilişkilerini</strong> taşıyabilecek biçimde
          tasarlanmıştır. Kurulum sırasında markanın kullanacağı yapı, her aktörün rolü ve hangi veriye erişeceği
          belirlenir. Kanal modeli zamanla değişirse eski araç ve sipariş kayıtları korunur.
        </p>
        <p class="mt-5 leading-relaxed text-warm-600">
          Kanalın hukuki niteliği, fiyat yetkisi, stok riski ve faturalama yapısı birbiriyle bağlantılıdır;
          müşteriye özgü hukuki ve mali yapı ilgili uzmanlara <strong>teyit ettirilir.</strong>
        </p>
      </div>
      <div>
        <h2 class="text-3xl font-semibold text-ink">Siparişten teslimata aynı araç kaydı</h2>
        <ol class="mt-6 space-y-3">
          {akıs.map((adim, i) => (
            <li class="flex items-center gap-4 rounded-lg bg-sand px-4 py-3">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent text-xs font-semibold text-white">{i + 1}</span>
              <span class="text-sm font-medium text-warm-700">{adim}</span>
            </li>
          ))}
        </ol>
        <p class="mt-5 leading-relaxed text-warm-600">
          İlk operasyonel kapsam, bu zincirin marka için öncelikli bölümünden başlar. Sistem daha sonra aynı araç kaydı korunarak genişler.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-14 sm:py-20">
    <div class="max-w-3xl">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-accent">Kurulum modeli</p>
      <h2 class="text-3xl font-semibold text-ink">İlk operasyonel kapsam 3–4 haftada kurulur</h2>
    </div>
    <ol class="mt-9 grid gap-5 sm:grid-cols-2">
      {kurulumAdimlari.map((adim, i) => (
        <li class="rounded-xl border border-warm-border bg-white p-6">
          <div class="flex items-start gap-4">
            <span class="text-2xl font-semibold text-accent">0{i + 1}</span>
            <div>
              <h3 class="text-xl font-semibold text-ink">{adim.baslik}</h3>
              <p class="mt-2 leading-relaxed text-warm-600">{adim.metin}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>
    <p class="mt-8 max-w-4xl text-sm leading-relaxed text-warm-500">
      3–4 haftalık hedef, ilk operasyonel kapsamın müşteri ve Arsan Danışmanlık arasında yapılan toplantılarla
      kurulmasını ifade eder. Takvim karar yetkilisinin, gerekli veri ve sistem erişimlerinin sağlanmasıyla başlar.
      İleri seviye entegrasyonlar, hukuki veya mali onay bekleyen adımlar planlanır.
    </p>
  </section>

  <section class="bg-ink text-paper">
    <div class="mx-auto grid max-w-5xl gap-10 px-4 py-14 sm:py-20 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div>
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-[#dc9a78]">Çalışan referans uygulama</p>
        <h2 class="text-3xl font-semibold text-paper">Çekirdek yapı çalışır ve test edilir</h2>
        <p class="mt-5 text-lg leading-relaxed text-[#ddd5ca]">
          Üretici ve Bayi, aynı kalıcı veri üzerinde ayrı kullanıcı hesapları ve farklı yetkilerle çalışır.
        </p>
      </div>
      <ul class="grid gap-x-7 gap-y-4 sm:grid-cols-2">
        {calisanKapsam.map((madde) => (
          <li class="flex gap-3 border-t border-white/15 pt-4 text-sm leading-relaxed text-[#ddd5ca]">
            <span class="mt-1 text-[#dc9a78]" aria-hidden="true">✓</span>
            <span>{madde}</span>
          </li>
        ))}
      </ul>
      <p class="text-sm leading-relaxed text-[#ddd5ca] lg:col-start-2">
        Bu akış, platformun sınırı değildir; talebe göre yeni işlevler eklenir, çıkarılır ya da revize edilir.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-14 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="text-3xl font-semibold text-ink">Bu ürün kimler için?</h2>
        <ul class="mt-7 grid gap-3">
          {hedefKurumlar.map((kurum) => (
            <li class="flex gap-3 rounded-lg border border-warm-border bg-white p-4 text-sm leading-relaxed text-warm-700">
              <span class="text-accent" aria-hidden="true">→</span>
              <span>{kurum}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="text-3xl font-semibold text-ink">Neden Arsan Danışmanlık?</h2>
        <div class="mt-6 space-y-5 text-lg leading-relaxed text-warm-700">
          <p>
            OSSS sistemi genel amaçlı bir yazılım projesi değil, Türkiye otomotiv sektörüne özgü bir sistem
            çözümüdür: Bir aracın müşteriye ulaşması; markanın benimseyeceği satış kanalı modeli, araç tanımı,
            sipariş, sevkiyat, stok, ödeme ve teslimat adımlarının aynı işletim modeli içinde ele alınmasını gerektirir.
          </p>
          <p class="font-semibold text-ink">
            Arsan Danışmanlık 35 yıllık otomotiv bilgisi ile sektöre özgü sistem kurma pratiğini bir araya getirir.
            Bu çalışmanın çıktısı bir danışmanlık raporu ya da tek başına çalışan bir yazılım değil, sizin
            ihtiyaçlarınıza özel tasarlanmış ve çalışır hâle getirilmiş bir işletim modelidir.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-8 sm:pb-12">
    <div class="rounded-2xl bg-sand px-6 py-10 text-center sm:px-10 sm:py-14">
