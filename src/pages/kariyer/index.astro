---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Content, frontmatter } from '../../icerik/kariyer.md';

const { baslik_tag, aciklama, etiket, baslik, giris, kesfet_baslik, kesfet_metin } = frontmatter;
---
<BaseLayout title={baslik_tag} description={aciklama}>
  <section class="mx-auto max-w-2xl px-4 py-16">
    <span class="inline-block text-xs font-semibold tracking-wide uppercase text-accent bg-sand rounded-full px-3 py-1 mb-4">
      {etiket}
    </span>
    <h1 class="text-3xl sm:text-4xl font-semibold text-ink mb-3">{baslik}</h1>
    <p class="text-lg text-warm-500 mb-12">{giris}</p>

    <div class="prose max-w-none
      prose-p:text-lg prose-p:leading-relaxed prose-p:text-warm-700
      prose-strong:text-ink prose-strong:font-semibold">
      <Content />
    </div>

    <a href="/kariyer/otomotiv-insani" class="mt-12 flex items-center justify-between gap-4 border border-warm-border rounded-lg p-6 bg-sand hover:border-accent transition-colors group">
      <div>
        <p class="text-ink font-medium mb-1">{kesfet_baslik}</p>
        <p class="text-sm text-warm-600">{kesfet_metin}</p>
      </div>
      <span class="shrink-0 text-accent font-medium group-hover:translate-x-1 transition-transform">→</span>
    </a>
  </section>
</BaseLayout>
