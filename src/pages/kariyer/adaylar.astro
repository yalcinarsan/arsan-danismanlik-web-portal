---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdaylarListesi from '../../components/AdaylarListesi.tsx';
---
<BaseLayout title="Adaylar" description="Kayıtlı adayların yönetici görünümü.">
  <meta name="robots" content="noindex" slot="head" />
  <section class="mx-auto max-w-3xl px-4 py-16">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent mb-3">Otomotiv İnsanı</p>
    <h1 class="text-3xl font-semibold text-ink mb-10">Adaylar</h1>
    <AdaylarListesi client:load />
  </section>
</BaseLayout>
