---
import { marked } from 'marked';
import raw from '../../sunumlar/ford-otosan-mdd.md?raw';

// Paper markdown'ını slaytlara böler.
// Kurallar:
//  - "----------" ayracı VEYA başlık (#, ##) yeni slayt başlatır.
//  - Her GÖRSEL kendi slaytına gider (Paper'ın otomatik davranışı).
//    İstisna: araya boş satır koymadan alt alta yazılan görseller aynı slaytta kalır.
function slaytlaraBol(md: string): string[] {
  const satirlar = md.split('\n');
  const slaytlar: string[][] = [];
  let mevcut: string[] = [];
  let mevcutGorsel = false;   // mevcut slayt bir görsel bloğu mu?
  let oncekiGorseldi = false; // bir önceki dolu satır görsel miydi? (bitişik gruplama)
  const flush = () => {
    if (mevcut.join('\n').trim()) slaytlar.push([...mevcut]);
    mevcut = [];
    mevcutGorsel = false;
  };
  for (let ham of satirlar) {
    const satir = ham.replace(/^\*{2,}(?=#)/, ''); // Paper export gürültüsü
    const t = satir.trim();
    const ayrac = /^-{3,}$/.test(t);
    const baslik = /^#{1,2}\s+/.test(t);
    const gorsel = /^!\[[^\]]*\]\([^)]*\)\s*$/.test(t);
    const bos = t === '';

    if (ayrac) { flush(); oncekiGorseldi = false; continue; }
    if (baslik) { flush(); mevcut.push(satir); oncekiGorseldi = false; continue; }
    if (gorsel) {
      if (mevcutGorsel && oncekiGorseldi) {
        mevcut.push(satir);          // bitişik görsel → aynı slayt
      } else {
        flush();
        mevcut.push(satir);
        mevcutGorsel = true;
      }
      oncekiGorseldi = true;
      continue;
    }
    if (bos) { mevcut.push(satir); oncekiGorseldi = false; continue; }
    // düz metin: bir görsel slaytının ardından geliyorsa yeni slayt aç
    if (mevcutGorsel) flush();
    mevcut.push(satir);
    oncekiGorseldi = false;
  }
  flush();
  return slaytlar.map((s) => s.join('\n'));
}

marked.setOptions({ gfm: true, breaks: false });
const slaytlar = slaytlaraBol(raw).map((chunk) => marked.parse(chunk) as string);
const toplam = slaytlar.length;
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Ford Otosan MDD Webinar — Sunum</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --paper:#faf7f2; --ink:#2c2620; --accent:#b5623c;
        --sand:#f1e9dd; --border:#e7ddcf; --muted:#857a69;
      }
      * { box-sizing:border-box; }
      html,body { margin:0; height:100%; background:var(--ink); }
      body { font-family:Inter,system-ui,sans-serif; }

      .deck { height:100vh; width:100vw; position:relative; overflow:hidden; }
      .slide {
        position:absolute; inset:0; display:none;
        padding:6vh 8vw; overflow-y:auto;
        background:var(--paper); color:var(--ink);
        flex-direction:column; justify-content:center;
      }
      .slide.active { display:flex; }
      .slide-inner { max-width:1000px; margin:0 auto; width:100%; }

      .slide h1 { font-family:'Fraunces',serif; font-weight:600; font-size:clamp(28px,4.4vw,52px);
        line-height:1.1; letter-spacing:-.01em; margin:0 0 .5em; color:var(--ink); }
      .slide h2 { font-family:'Fraunces',serif; font-weight:600; font-size:clamp(22px,3.2vw,38px);
        line-height:1.15; margin:0 0 .5em; color:var(--ink); }
      .slide h3 { font-family:'Fraunces',serif; font-weight:500; font-size:clamp(18px,2.4vw,26px);
        margin:0 0 .4em; color:var(--ink); }
      .slide p, .slide li { font-size:clamp(15px,1.7vw,21px); line-height:1.55; color:#4a4238; }
      .slide ul, .slide ol { margin:.3em 0 .3em 1.1em; padding:0; }
      .slide li { margin:.28em 0; }
      .slide li::marker { color:var(--accent); }
      .slide strong { color:var(--ink); font-weight:600; }
      .slide em { color:var(--accent); font-style:normal; font-weight:500; }
      .slide del { color:var(--muted); }
      .slide a { color:var(--accent); }
      .slide img { max-width:100%; max-height:64vh; width:auto; margin:1em auto; display:block;
        border-radius:8px; box-shadow:0 4px 24px rgba(0,0,0,.12); }
      .slide code { background:var(--sand); padding:.1em .35em; border-radius:4px; font-size:.9em; }
      .slide hr { display:none; }
      .slide table { border-collapse:collapse; margin:1em auto; font-size:clamp(13px,1.5vw,18px); }
      .slide th, .slide td { border:1px solid var(--border); padding:.4em .7em; text-align:left; }
      .slide th { background:var(--sand); }

      /* kapak slaytı biraz daha havalı dursun */
      .slide:first-child h1 { font-size:clamp(32px,6vw,72px); }

      .hud { position:fixed; bottom:18px; right:22px; z-index:10;
        font-size:13px; color:var(--paper); background:rgba(44,38,32,.6);
        padding:6px 12px; border-radius:20px; backdrop-filter:blur(4px);
        display:flex; gap:14px; align-items:center; }
      .hud button { all:unset; cursor:pointer; color:var(--paper); opacity:.8; padding:2px 6px; }
      .hud button:hover { opacity:1; }
      .say { font-variant-numeric:tabular-nums; opacity:.9; }
      .ipucu { position:fixed; bottom:18px; left:22px; z-index:10; font-size:12px;
        color:rgba(250,247,242,.6); }
      @media (max-width:640px){ .ipucu{ display:none; } }
    </style>
  </head>
  <body>
    <div class="deck" id="deck">
      {slaytlar.map((html, i) => (
        <section class={`slide${i === 0 ? ' active' : ''}`} data-i={i}>
          <div class="slide-inner" set:html={html} />
        </section>
      ))}
    </div>

    <div class="ipucu">← → ok tuşları · F tam ekran</div>
    <div class="hud">
      <button id="prev" aria-label="Önceki">‹</button>
      <span class="say"><span id="cur">1</span> / {toplam}</span>
      <button id="next" aria-label="Sonraki">›</button>
      <button id="fs" aria-label="Tam ekran">⤢</button>
    </div>

    <script define:vars={{ toplam }}>
      const slaytlar = [...document.querySelectorAll('.slide')];
      const curEl = document.getElementById('cur');
      let i = 0;
      function goster(n) {
        i = Math.max(0, Math.min(toplam - 1, n));
        slaytlar.forEach((s, k) => s.classList.toggle('active', k === i));
        curEl.textContent = String(i + 1);
        const aktif = slaytlar[i];
        if (aktif) aktif.scrollTop = 0;
      }
      function sonraki() { goster(i + 1); }
      function onceki() { goster(i - 1); }
      document.getElementById('next').onclick = sonraki;
      document.getElementById('prev').onclick = onceki;
      document.getElementById('fs').onclick = () => {
        if (!document.fullscreenElement) document.documentElement.requestFullscreen();
        else document.exitFullscreen();
      };
      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'PageDown' || e.key === ' ') { e.preventDefault(); sonraki(); }
        else if (e.key === 'ArrowLeft' || e.key === 'PageUp') { e.preventDefault(); onceki(); }
        else if (e.key === 'Home') goster(0);
        else if (e.key === 'End') goster(toplam - 1);
        else if (e.key.toLowerCase() === 'f') document.getElementById('fs').click();
      });
    </script>
  </body>
</html>
